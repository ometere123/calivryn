{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "WebWorker"],
    "module": "ESNext", "moduleResolution": "Bundler", "noEmit": true, "esModuleInterop": true,
    "strict": true, "skipLibCheck": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": ["worker", "shared"]
}
