{
  "name": "calivryn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-grounded AI-assisted calibration service report preparation",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --config vite.e2e.config.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "live-smoke": "node scripts/live-smoke.mjs",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.36.0"
  }
}
