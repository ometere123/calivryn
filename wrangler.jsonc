{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calivryn",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": { "enabled": true, "persist": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1, "persist": true }
  },
  "ai": { "binding": "AI" },
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "ratelimits": [
    { "name": "AI_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 4, "period": 60 } },
    { "name": "GLOBAL_AI_BUDGET", "namespace_id": "1002", "simple": { "limit": 12, "period": 60 } }
  ]
}
